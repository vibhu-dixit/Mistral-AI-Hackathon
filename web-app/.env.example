# "true" (default) serves the skeleton data in src/lib/mock/ instead of
# calling the real backend — see PLAN.md §5.3. Set to "false" once the
# AI/Backend lead's endpoints are up.
NEXT_PUBLIC_USE_MOCK_DATA=true

# Base URL for the backend's /analyze-image, /analyze-video, /hazards
# endpoints. Only used when NEXT_PUBLIC_USE_MOCK_DATA=false.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
