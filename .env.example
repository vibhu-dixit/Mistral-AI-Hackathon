# Mistral — used only on the server
MISTRAL_API_KEY=
MISTRAL_VISION_MODEL=mistral-small-latest
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_AGENT_MODEL=mistral-small-latest

# Supabase
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=
